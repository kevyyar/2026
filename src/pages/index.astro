---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/sections/Hero.astro";
import Marquee from "../components/sections/Marquee.astro";
import { projects } from "../data/projects";

export const prerender = true;

const title = "Kevin Barreto — Independent Software Developer & Consultant";
const description =
  "Kevin Barreto is an independent software developer and consultant in México. A software studio of one: planning, design, engineering and launch of web products for businesses worldwide.";
---

<BaseLayout title={title} description={description} image={projects[0].image} imageAlt={projects[0].imageAlt} preloader>
  <Hero />
  <section id="about" class="sheet surface-light pb-40">
    <Marquee />
  </section>
</BaseLayout>
