---
import SectionHeading from "../ui/SectionHeading.astro";
import { services } from "../../data/services";
---

<section id="services" class="sheet surface-ink on-ink services" aria-labelledby="services-title">
  <div class="shell">
    <SectionHeading id="services-title" index="03" label="Services" count={String(services.length).padStart(2, "0")}>
      What <span class="accent">I do</span>
      <Fragment slot="intro">
        Six ways I can help — from a single landing page to a product that runs your business. Pick one, or hand me
        the whole thing.
      </Fragment>
    </SectionHeading>

    <ul class="services__list" data-accordion>
      {
        services.map((service, index) => {
          const number = String(index + 1).padStart(2, "0");
          const panelId = `service-panel-${number}`;
          const buttonId = `service-button-${number}`;
          return (
            <li class="service" data-accordion-item>
              <h3 class="service__heading">
                <button
                  id={buttonId}
                  type="button"
                  class="service__button"
                  aria-expanded="true"
                  aria-controls={panelId}
                  data-accordion-button
                >
                  <span class="service__index display" aria-hidden="true">
                    {number}
                  </span>
                  <span class="service__title display">{service.title}</span>
                  <span class="service__icon" aria-hidden="true" />
                </button>
              </h3>
              <div id={panelId} class="service__panel" role="region" aria-labelledby={buttonId} data-accordion-panel>
                <div class="service__panel-inner">
                  <p class="service__description lead">{service.description}</p>
                  <ul class="service__features" aria-label={`${service.title} includes`}>
                    {service.features.map((feature) => (
                      <li class="chip">{feature}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>

<style>
  .services {
    padding-top: clamp(3.5rem, 8vw, 7rem);
    padding-bottom: calc(var(--radius-sheet) + clamp(4rem, 9vw, 8rem));
  }

  .services__list {
    margin-top: clamp(2.5rem, 6vw, 5rem);
    border-top: 1px solid var(--color-line-inverse);
  }

  .service {
    position: relative;
    border-bottom: 1px solid var(--color-line-inverse);
    isolation: isolate;
  }

  /* Paper fill sweeps in from the left on hover and when expanded. */
  .service::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--color-paper-deep);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.7s var(--ease-out-expo);
  }

  .service:hover::before,
  .service.is-open::before {
    transform: scaleX(1);
  }

  .service:hover,
  .service.is-open {
    color: var(--color-ink);
  }

  .service:hover :global(.chip),
  .service.is-open :global(.chip) {
    border-color: var(--color-line);
  }

  .service__heading {
    margin: 0;
  }

  .service__button {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    width: 100%;
    min-height: 5rem;
    padding: 1.1rem 0.5rem;
    color: inherit;
    text-align: left;
    transition: color 0.4s, padding 0.6s var(--ease-out-expo);
  }

  @media (min-width: 1024px) {
    .service__button {
      gap: 2rem;
      padding: 1.6rem 1rem;
    }

    .service:hover .service__button {
      padding-left: 2rem;
    }
  }

  .service__index {
    min-width: 2.2ch;
    font-size: clamp(2rem, 5vw, 4.5rem);
    color: transparent;
    -webkit-text-stroke: 1px currentColor;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .service__button > .service__index {
    -webkit-text-stroke-color: var(--color-signal);
  }

  .service__title {
    font-size: clamp(1.45rem, 4.2vw, 3.6rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .service__icon {
    position: relative;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid currentColor;
    transition: transform 0.6s var(--ease-out-expo), background-color 0.4s, color 0.4s;
  }

  .service__icon::before,
  .service__icon::after {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0.9rem;
    height: 1.5px;
    background: currentColor;
    translate: -50% -50%;
  }

  .service__icon::after {
    rotate: 90deg;
  }

  .service.is-open .service__icon {
    transform: rotate(135deg);
    background: var(--color-ink);
    color: var(--color-paper);
    border-color: var(--color-ink);
  }

  .service__panel {
    overflow: hidden;
  }

  .service__panel-inner {
    display: grid;
    gap: 1.25rem;
    padding: 0 0.5rem 1.75rem;
  }

  @media (min-width: 1024px) {
    .service__panel-inner {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: 2rem;
      padding: 0 1rem 2.25rem calc(1rem + 2.2ch * 1.1 + 2rem);
    }
  }

  .service__description {
    max-width: 40ch;
  }

  .service__features {
    display: flex;
    flex-wrap: wrap;
    align-content: start;
    gap: 0.5rem;
  }
</style>
