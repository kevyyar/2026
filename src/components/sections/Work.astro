---
import SectionHeading from "../ui/SectionHeading.astro";
import FeaturedProject from "../work/FeaturedProject.astro";
import { projects } from "../../data/projects";

const [featured] = projects;
---

<section id="work" class="sheet surface-paper work" aria-labelledby="work-title">
  <div class="shell">
    <SectionHeading id="work-title" index="02" label="Case study">
      Featured <span class="accent">work</span>
      <Fragment slot="intro">
        One engagement, end to end: strategy, a bilingual build and a launch — with the numbers that followed.
      </Fragment>
    </SectionHeading>

    <div class="work__feature">
      <FeaturedProject
        project={featured}
        href={`/work/${featured.slug}`}
        labels={{ featured: "Featured case", results: "Results", stack: "Stack", cta: "Read case study" }}
      />
    </div>
  </div>
</section>

<style>
  .work {
    padding-top: clamp(3.5rem, 8vw, 7rem);
    padding-bottom: calc(var(--radius-sheet) + clamp(3rem, 8vw, 6rem));
  }

  .work__feature {
    padding-top: clamp(2.5rem, 6vw, 5rem);
  }
</style>
