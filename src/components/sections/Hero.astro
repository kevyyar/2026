---
import RotatingBadge from "../ui/RotatingBadge.astro";
import { getI18n } from "../../i18n/astro";
import { accentHtml } from "../../i18n/markup";

const { t } = getI18n(Astro);
// "Line one —|line two|*accent*": one entry per visual line; a trailing " —" only shows from md up.
const lines = t("hero.title")
  .split("|")
  .map((line) => {
    const dash = line.endsWith(" —");
    return { html: accentHtml(dash ? line.slice(0, -2) : line), dash };
  });
---

<section id="home" class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <div class="blueprint hero__grid"></div>
    <div class="blueprint-cross hero__grid"></div>
    <canvas class="hero__canvas" data-dot-field></canvas>
  </div>

  <div class="shell hero__content" data-hero-content>
    <div class="hero__meta">
      <p class="mono" data-hero-fade>
        {t("hero.kicker")}<br class="sm:hidden" />
        <span class="max-sm:hidden"> — </span>{t("hero.origin")}
      </p>
      <p class="mono muted max-md:hidden" data-hero-fade>{t("hero.est")}</p>
    </div>

    <h1 id="hero-title" class="display hero__title" data-hero-title data-lines={lines.length}>
      {
        lines.map((line) => (
          <span class="hero__line">
            <Fragment set:html={line.html} />
            {line.dash && <span class="hero__dash"> —</span>}
          </span>
        ))
      }
    </h1>

    <div class="hero__foot">
      <p class="lead hero__lead" data-hero-fade>{t("hero.lead")}</p>
      <div class="hero__ctas" data-hero-fade>
        <a class="btn btn-primary" href="#contact" data-magnetic>
          {t("cta.start")} <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn-ghost" href="#work">{t("hero.seeWork")}</a>
      </div>
      <div class="hero__badge" data-hero-badge>
        <RotatingBadge href="#work" label={t("hero.badgeLabel")} text={t("hero.badgeText")} />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: clip;
    background: var(--color-paper);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  .hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    min-height: 100svh;
    padding-top: calc(var(--nav-h) + 1.25rem);
    padding-bottom: calc(var(--radius-sheet) + 2rem);
    transform-origin: 50% 0%;
    pointer-events: none;
  }

  .hero__content :is(a, button) {
    pointer-events: auto;
  }

  .hero__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .hero__title {
    font-size: clamp(3.1rem, 14.2vw, 12.5rem);
    font-weight: 800;
    line-height: 0.86;
    text-wrap: initial;
  }

  .hero__title :global(.accent) {
    font-weight: 400;
    padding-right: 0.06em;
  }

  .hero__line {
    display: block;
    white-space: nowrap;
  }

  .hero__dash {
    display: none;
  }

  @media (min-width: 768px) {
    .hero__title {
      font-size: clamp(3.1rem, 11.4vw, 12.5rem);
    }

    /* Four-line titles (Spanish) scale down to keep the fold. */
    .hero__title[data-lines="4"] {
      font-size: clamp(3.1rem, 9.2vw, 10rem);
    }

    .hero__dash {
      display: inline;
    }
  }

  .hero__foot {
    display: grid;
    gap: 1.75rem;
    align-items: end;
  }

  .hero__lead {
    max-width: 34ch;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__badge {
    position: absolute;
    right: var(--gutter);
    bottom: calc(var(--radius-sheet) + 2rem);
    pointer-events: auto;
  }

  @media (max-width: 639px) {
    .hero__badge {
      position: static;
      justify-self: end;
      margin-top: -5.5rem;
    }

    .hero__ctas {
      max-width: calc(100% - 8rem);
    }
  }

  @media (min-width: 1024px) {
    .hero__foot {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: 1.5rem;
    }

    .hero__ctas {
      align-self: end;
    }
  }
</style>
