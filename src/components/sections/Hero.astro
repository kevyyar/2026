---
import RotatingBadge from "../ui/RotatingBadge.astro";
---

<section id="home" class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <div class="blueprint hero__grid"></div>
    <div class="blueprint-cross hero__grid"></div>
    <canvas class="hero__canvas" data-dot-field></canvas>
  </div>

  <div class="shell hero__content" data-hero-content>
    <div class="hero__meta">
      <p class="mono" data-hero-fade>
        Independent developer &amp; consultant<br class="sm:hidden" />
        <span class="max-sm:hidden"> — </span>México → worldwide
      </p>
      <p class="mono muted max-md:hidden" data-hero-fade>(Est. 2019)</p>
    </div>

    <h1 id="hero-title" class="display hero__title" data-hero-title>
      <span class="hero__line">Kevin Barreto<span class="hero__dash"> —</span></span>
      <span class="hero__line">a software</span>
      <span class="hero__line">studio <em class="accent">of&nbsp;one.</em></span>
    </h1>

    <div class="hero__foot">
      <p class="lead hero__lead" data-hero-fade>
        I plan, design, build and ship web products for businesses that need them done right. One accountable partner
        — from the first call to the last deploy.
      </p>
      <div class="hero__ctas" data-hero-fade>
        <a class="btn btn-primary" href="#contact" data-magnetic>
          Start a project <span class="btn-arrow" aria-hidden="true">→</span>
        </a>
        <a class="btn btn-ghost" href="#work">See the work</a>
      </div>
      <div class="hero__badge" data-hero-badge>
        <RotatingBadge href="#work" label="Scroll to selected work" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    overflow: clip;
    background: var(--color-paper);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
  }

  .hero__grid {
    position: absolute;
    inset: 0;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    touch-action: pan-y;
  }

  .hero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    min-height: 100svh;
    padding-top: calc(var(--nav-h) + 1.25rem);
    padding-bottom: calc(var(--radius-sheet) + 2rem);
    transform-origin: 50% 0%;
    pointer-events: none;
  }

  .hero__content :is(a, button) {
    pointer-events: auto;
  }

  .hero__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .hero__title {
    font-size: clamp(3.1rem, 14.2vw, 12.5rem);
    font-weight: 800;
    line-height: 0.86;
    text-wrap: initial;
  }

  .hero__title .accent {
    font-weight: 400;
    padding-right: 0.06em;
  }

  .hero__line {
    display: block;
    white-space: nowrap;
  }

  .hero__dash {
    display: none;
  }

  @media (min-width: 768px) {
    .hero__title {
      font-size: clamp(3.1rem, 11.4vw, 12.5rem);
    }

    .hero__dash {
      display: inline;
    }
  }

  .hero__foot {
    display: grid;
    gap: 1.75rem;
    align-items: end;
  }

  .hero__lead {
    max-width: 34ch;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__badge {
    position: absolute;
    right: var(--gutter);
    bottom: calc(var(--radius-sheet) + 2rem);
    pointer-events: auto;
  }

  @media (max-width: 639px) {
    .hero__badge {
      position: static;
      justify-self: end;
      margin-top: -5.5rem;
    }

    .hero__ctas {
      max-width: calc(100% - 8rem);
    }
  }

  @media (min-width: 1024px) {
    .hero__foot {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: 1.5rem;
    }

    .hero__ctas {
      align-self: end;
    }
  }
</style>
