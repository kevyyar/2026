---
import ContactForm from "../contact/ContactForm.tsx";
import { profile } from "../../data/profile";
---

<section id="contact" class="sheet surface-ink on-ink contact" aria-labelledby="contact-title">
  <div class="shell contact__grid">
    <div class="contact__intro">
      <p class="mono"><span class="contact__index">(07)</span> — Contact</p>
      <h2 id="contact-title" class="display contact__title" data-reveal="lines">
        Got a project? <span class="accent">Let’s build&nbsp;it.</span>
      </h2>
      <p class="lead muted contact__lead" data-reveal="fade">
        Tell me what you’re building, where it stands and what success looks like. I read every message myself.
      </p>

      <div class="contact__email" data-reveal="fade" data-copy-scope>
        <p class="mono muted">Write directly</p>
        <div class="contact__email-row">
          <a class="contact__email-link display link-underline" href={`mailto:${profile.email}`}>{profile.email}</a>
          <button
            type="button"
            class="contact__copy mono"
            data-copy={profile.email}
            data-copy-done="Copied"
            data-copy-failed="Couldn’t copy — use the email link"
            hidden
          >
            <span data-copy-label>Copy</span>
          </button>
        </div>
        <p class="sr-only" aria-live="polite" data-copy-status></p>
      </div>

      <dl class="contact__facts" data-reveal="fade">
        <div>
          <dt class="mono muted">Reply time</dt>
          <dd>Within 24 hours</dd>
        </div>
        <div>
          <dt class="mono muted">Languages</dt>
          <dd>English / Español</dd>
        </div>
        <div>
          <dt class="mono muted">Local time</dt>
          <dd><time data-clock>GMT−6</time> · México</dd>
        </div>
        <div>
          <dt class="mono muted">Elsewhere</dt>
          <dd class="contact__links">
            <a class="link-underline" href={profile.linkedin} target="_blank" rel="noopener noreferrer">
              LinkedIn <span aria-hidden="true">↗</span>
            </a>
            <a class="link-underline" href={profile.github} target="_blank" rel="noopener noreferrer">
              GitHub <span aria-hidden="true">↗</span>
            </a>
          </dd>
        </div>
      </dl>
    </div>

    <div class="contact__form">
      <ContactForm client:visible />
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: clamp(4rem, 9vw, 8rem) calc(var(--radius-sheet) + clamp(4rem, 9vw, 8rem));
  }

  .contact__grid {
    display: grid;
    gap: clamp(3rem, 7vw, 5rem);
  }

  .contact__intro {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  .contact__index {
    color: var(--color-signal);
  }

  .contact__title {
    font-size: clamp(3rem, 9vw, 8.5rem);
    line-height: 0.9;
  }

  .contact__lead {
    max-width: 34ch;
  }

  .contact__email {
    display: grid;
    gap: 0.5rem;
  }

  .contact__email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .contact__email-link {
    font-size: clamp(1.45rem, 4.2vw, 2.8rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    overflow-wrap: anywhere;
    color: var(--color-paper);
  }

  .contact__email-link:hover {
    color: var(--color-signal);
  }

  .contact__copy {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--color-line-inverse);
    border-radius: 999px;
    color: var(--color-paper);
    transition: background-color 0.3s, color 0.3s, border-color 0.3s;
  }

  .contact__copy:hover {
    border-color: var(--color-paper);
  }

  .contact__copy.is-copied {
    background: var(--color-signal);
    border-color: var(--color-signal);
    color: var(--color-ink);
  }

  .contact__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
  }

  .contact__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-line-inverse);
  }

  .contact__facts dd {
    margin-top: 0.35rem;
    font-weight: 500;
  }

  .contact__facts a {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .contact__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: 4rem;
    }

    .contact__intro {
      position: sticky;
      top: calc(var(--nav-h) + 2rem);
      align-self: start;
    }
  }
</style>
