---
import type { Project } from "../../data/types";
import BrowserFrame from "./BrowserFrame.astro";
import CountUp from "../ui/CountUp.astro";

type Props = {
  project: Project;
  index: number;
  total: number;
};

const { project, index, total } = Astro.props;
const number = String(index + 1).padStart(2, "0");
const surface = index % 2 === 0 ? "light" : "ink";
const highlights = project.results.slice(0, 2);
---

<li class="stack__item" style={`--i: ${index}`} data-stack-item>
  <article
    class:list={["card", `card--${surface}`, { "on-ink": surface === "ink" }]}
    data-stack-card
    data-cursor="view"
  >
    <div class="card__shade" data-stack-shade aria-hidden="true"></div>

    <div class="card__info">
      <div class="card__meta mono">
        <span class="card__count">{number} / {String(total).padStart(2, "0")}</span>
        <span class="chip">{project.industry}</span>
      </div>

      <div class="card__heading">
        <p class="card__client mono muted">{project.client}</p>
        <h3 class="card__title display display-s">
          <a href={`/work/${project.slug}`} class="card__link">{project.title}</a>
        </h3>
      </div>

      <dl class="card__metrics">
        {
          highlights.map((metric) => (
            <div class="card__metric">
              <dt class="mono muted">{metric.label}</dt>
              <dd class="card__metric-value display">
                <CountUp value={metric.value} />
              </dd>
            </div>
          ))
        }
      </dl>

      <ul class="card__tags" aria-label="Stack">
        {project.tags.map((tag) => <li class="chip">{tag}</li>)}
      </ul>

      <span class="card__cta" aria-hidden="true">
        Read case study <span class="card__arrow" aria-hidden="true">→</span>
      </span>
    </div>

    <div class="card__media" data-reveal="clip">
      <BrowserFrame
        image={project.image}
        alt={project.imageAlt}
        url={project.websiteUrl}
        transitionName={`work-${project.slug}`}
        sizes="(min-width: 1024px) 56vw, 92vw"
      />
    </div>
  </article>
</li>

<style>
  .stack__item {
    position: sticky;
    top: calc(var(--nav-h) + var(--i) * 0.9rem);
    padding-bottom: 1.25rem;
  }

  /* Short screens: cards would not fit, so they scroll normally. */
  @media (max-height: 699px) {
    .stack__item {
      position: relative;
      top: 0;
    }
  }

  .card {
    position: relative;
    display: grid;
    gap: 1.25rem;
    padding: 1rem;
    border-radius: 24px;
    overflow: hidden;
    transform-origin: 50% 0%;
    will-change: transform;
  }

  .card--light {
    background: var(--color-paper-light);
    color: var(--color-ink);
    border: 1px solid var(--color-line);
  }

  .card--ink {
    background: var(--color-ink);
    color: var(--color-paper);
  }

  /* Stretched link: the whole card is clickable, the title is the accessible name. */
  .card__link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 3;
    border-radius: inherit;
  }

  .card__link:focus-visible {
    outline: none;
  }

  .card:has(.card__link:focus-visible) {
    outline: 2px solid var(--color-cobalt);
    outline-offset: 4px;
  }

  .card--ink:has(.card__link:focus-visible) {
    outline-color: var(--color-signal);
  }

  .card__shade {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: var(--color-ink);
    opacity: 0;
    pointer-events: none;
  }

  .card__info {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .card__count {
    font-variant-numeric: tabular-nums;
  }

  .card__heading {
    display: grid;
    gap: 0.5rem;
  }

  .card__title {
    font-size: clamp(1.55rem, 3.3vw, 3.1rem);
    max-width: 18ch;
    transition: color 0.4s;
  }

  .card__metrics {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    padding-top: 0.75rem;
    border-top: 1px solid currentColor;
    border-color: color-mix(in srgb, currentColor 18%, transparent);
  }

  .card__metric {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.35rem;
  }

  .card__metric-value {
    font-size: clamp(1.9rem, 4vw, 3.6rem);
    font-variant-numeric: tabular-nums;
    line-height: 0.95;
  }

  .card--ink .card__metric-value {
    color: var(--color-signal);
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .card__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    font-weight: 600;
  }

  .card__arrow {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    background: var(--color-signal);
    color: var(--color-ink);
    transition: transform 0.5s var(--ease-out-expo);
  }

  .card:hover .card__arrow,
  .card:has(.card__link:focus-visible) .card__arrow {
    transform: translateX(6px) rotate(-45deg);
  }

  .card--light:hover .card__title {
    color: var(--color-signal-deep);
  }

  .card--ink:hover .card__title {
    color: var(--color-signal);
  }

  .card__media {
    align-self: center;
  }

  @media (max-width: 639px) {
    .card__tags {
      display: none;
    }

    .card__media {
      order: -1;
    }
  }

  @media (min-width: 1024px) {
    .card {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: 2rem;
      padding: 1.5rem;
      min-height: min(78vh, 46rem);
    }

    .card__info {
      grid-template-rows: auto 1fr auto auto auto;
      gap: 1.25rem;
    }

    .card__heading {
      align-self: center;
    }
  }
</style>
