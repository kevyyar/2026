---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { profile } from "../../data/profile";

type Props = {
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown>[];
};

const { title, description, image, imageAlt, type = "website", jsonLd = [] } = Astro.props;

const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = await getImage({ src: image, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 80 });
const ogImageUrl = new URL(ogImage.src, site).href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="author" content={profile.name} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={profile.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content="en_US" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{jsonLd.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}
