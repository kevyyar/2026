---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import { profile } from "../../data/profile";
import { defaultLocale, localeMeta, locales } from "../../i18n/config";
import { getAlternatePath } from "../../i18n/paths";
import { getI18n } from "../../i18n/astro";

type Props = {
  title: string;
  description: string;
  image: ImageMetadata;
  imageAlt: string;
  type?: "website" | "article";
  jsonLd?: Record<string, unknown>[];
};

const { title, description, image, imageAlt, type = "website", jsonLd = [] } = Astro.props;

const { locale } = getI18n(Astro);
const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site).href;
const alternates = locales.map((alt) => ({
  hreflang: alt,
  href: new URL(getAlternatePath(Astro.url.pathname, alt), site).href,
}));
const xDefault = new URL(getAlternatePath(Astro.url.pathname, defaultLocale), site).href;
const ogImage = await getImage({ src: image, width: 1200, height: 630, fit: "cover", format: "jpg", quality: 80 });
const ogImageUrl = new URL(ogImage.src, site).href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
<link rel="alternate" hreflang="x-default" href={xDefault} />
<meta name="author" content={profile.name} />

<meta property="og:type" content={type} />
<meta property="og:site_name" content={profile.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:locale" content={localeMeta[locale].ogLocale} />
{
  locales
    .filter((alt) => alt !== locale)
    .map((alt) => <meta property="og:locale:alternate" content={localeMeta[alt].ogLocale} />)
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{jsonLd.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}
