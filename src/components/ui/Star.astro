---
/** Eight-point burst used as a separator glyph (font-independent). */
type Props = { class?: string };
const { class: className } = Astro.props;

const points = Array.from({ length: 16 }, (_, i) => {
  const angle = (Math.PI / 8) * i - Math.PI / 2;
  const radius = i % 2 === 0 ? 10 : 3.6;
  return `${(12 + Math.cos(angle) * radius).toFixed(2)},${(12 + Math.sin(angle) * radius).toFixed(2)}`;
}).join(" ");
---

<svg class={className} viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  <polygon points={points} fill="currentColor"></polygon>
</svg>
