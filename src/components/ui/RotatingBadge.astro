---
type Props = {
  href: string;
  label: string;
  text?: string;
  class?: string;
};

const { href, label, text = "AVAILABLE • FOR • PROJECTS • 2026 • ", class: className } = Astro.props;
const id = `badge-path-${Math.random().toString(36).slice(2, 8)}`;
---

<a href={href} class:list={["badge", className]} aria-label={label} data-cursor="hover">
  <svg class="badge__ring" viewBox="0 0 200 200" aria-hidden="true">
    <defs>
      <path id={id} d="M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0"></path>
    </defs>
    <text>
      <textPath href={`#${id}`} textLength="486" lengthAdjust="spacing">{text}</textPath>
    </text>
  </svg>
  <span class="badge__core" aria-hidden="true">
    <svg viewBox="0 0 24 24" class="badge__arrow"><path d="M12 4v15M5.5 12.5 12 19l6.5-6.5" fill="none" stroke="currentColor" stroke-width="2"></path></svg>
  </span>
</a>

<style>
  .badge {
    position: relative;
    display: grid;
    place-items: center;
    width: 7.5rem;
    aspect-ratio: 1;
    border-radius: 50%;
    color: var(--color-ink);
  }

  @media (min-width: 1024px) {
    .badge {
      width: 10rem;
    }
  }

  .badge__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: badge-spin 18s linear infinite;
  }

  .badge__ring text {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.1em;
    fill: currentColor;
  }

  .badge__core {
    display: grid;
    place-items: center;
    width: 44%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-signal);
    color: var(--color-ink);
    transition: transform 0.6s var(--ease-out-expo), background-color 0.4s;
  }

  .badge__arrow {
    width: 42%;
    transition: transform 0.6s var(--ease-out-expo);
  }

  .badge:hover .badge__core {
    transform: scale(1.12);
    background: var(--color-ink);
    color: var(--color-paper);
  }

  .badge:hover .badge__arrow {
    transform: translateY(3px);
  }

  @keyframes badge-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .badge__ring {
      animation: none;
    }
  }
</style>
